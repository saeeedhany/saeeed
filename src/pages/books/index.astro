---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allBooks = await getCollection('books', ({ data }) => !data.draft);

const byStatus = {
  reading: allBooks.filter(b => b.data.status === 'reading'),
  read:    allBooks.filter(b => b.data.status === 'read'),
  want:    allBooks.filter(b => b.data.status === 'want'),
};

const statusLabel: Record<string, string> = {
  reading: 'Currently Reading',
  read:    'Read',
  want:    'Want to Read',
};

const statusColor: Record<string, string> = {
  reading: 'var(--amber)',
  read:    'var(--phosphor)',
  want:    'var(--muted)',
};

const allTags = [...new Set(allBooks.flatMap(b => b.data.tags))].sort();
---

<Base title="Books - Saeed">
  <div class="container">

    <div class="page-verse page-verse--single" dir="rtl">
        <p>وَاستَثْمِرِ العَقْلَ فِى عِلْمٍ وَفِي أَدَبِ</p>
        <p>لَمْ يُخلَقِ العَقْلُ حَتَّى يُمْتَلَى سَفَهَا</p>
    </div>

    <div class="section-label" style="margin-bottom: 32px;">Books</div>

    <p class="books-intro">
      Things I've read, am reading, or intend to read. With notes.
    </p>

    <!-- Tag filter -->
    <div class="tag-filter" id="books-tag-filter">
      <button class="tag-btn active" data-tag="all">All</button>
      {allTags.map(tag => (
        <button class="tag-btn" data-tag={tag}>{tag}</button>
      ))}
    </div>

    <!-- Sections by status -->
    {(['reading', 'read', 'want'] as const).filter(s => byStatus[s].length > 0).map(status => (
      <section class="books-section" data-status={status}>
        <div class="books-section-label" style={`color: ${statusColor[status]}`}>
          {statusLabel[status]}
          <span class="books-count">{byStatus[status].length}</span>
        </div>
        <div class="books-grid" id={`books-grid-${status}`}>
          {byStatus[status].map(book => (
            <a href={`/books/${book.slug}`} class="book-card" data-tags={book.data.tags.join(',')}>
              <div class="book-card-cover">
                {book.data.cover ? (
                  <img src={book.data.cover} alt={book.data.title} />
                ) : (
                  <div class="book-card-cover-placeholder">
                    <span>{book.data.title.slice(0, 2).toUpperCase()}</span>
                  </div>
                )}
              </div>
              <div class="book-card-body">
                <div class="book-card-title">{book.data.title}</div>
                <div class="book-card-author">{book.data.author}</div>
                {book.data.year && (
                  <div class="book-card-year">{book.data.year}</div>
                )}
                {book.data.rating && status !== 'want' && (
                  <div class="book-card-rating">
                    {'★'.repeat(book.data.rating)}{'☆'.repeat(5 - book.data.rating)}
                  </div>
                )}
                <div class="book-card-tags">
                  {book.data.tags.map(tag => (
                    <span class="book-tag">{tag}</span>
                  ))}
                </div>
              </div>
              <div class="book-card-arrow">→</div>
            </a>
          ))}
        </div>
      </section>
    ))}

  </div>
</Base>




