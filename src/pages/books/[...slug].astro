---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const books = await getCollection('books', ({ data }) => !data.draft);
  return books.map(book => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await book.render();

// Resolve related posts from both EN and AR collections
const relatedPosts: Array<{ title: string; href: string; lang: string }> = [];
for (const slug of book.data.relatedPosts) {
  const enPost = await getEntry('en', slug).catch(() => null);
  if (enPost) { relatedPosts.push({ title: enPost.data.title, href: `/posts/en/${slug}`, lang: 'en' }); continue; }
  const arPost = await getEntry('ar', slug).catch(() => null);
  if (arPost) { relatedPosts.push({ title: arPost.data.title, href: `/posts/ar/${slug}`, lang: 'ar' }); }
}

const statusLabel: Record<string, string> = {
  reading: 'Currently Reading',
  read:    'Read',
  want:    'Want to Read',
};

const statusColor: Record<string, string> = {
  reading: 'var(--amber)',
  read:    'var(--phosphor)',
  want:    'var(--muted)',
};
---

<Base title={`${book.data.title} — Saeed`} description={book.data.description}>
  <div class="container">

    <div class="book-back">
      <a href="/books" class="back-link">← books</a>
    </div>

    <div class="book-detail">

      <!-- Left: cover -->
      <div class="book-detail-cover">
        {book.data.cover ? (
          <img src={book.data.cover} alt={book.data.title} class="book-cover-img" />
        ) : (
          <div class="book-cover-placeholder">
            <span>{book.data.title.slice(0, 3).toUpperCase()}</span>
          </div>
        )}
      </div>

      <!-- Right: meta -->
      <div class="book-detail-meta">
        <div class="book-detail-title">{book.data.title}</div>
        <div class="book-detail-author">{book.data.author}</div>

        <div class="book-detail-fields">
          {book.data.year && (
            <div class="book-field">
              <span class="book-field-label">year</span>
              <span class="book-field-value">{book.data.year}</span>
            </div>
          )}
          <div class="book-field">
            <span class="book-field-label">status</span>
            <span class="book-field-value" style={`color: ${statusColor[book.data.status]}`}>
              {statusLabel[book.data.status]}
            </span>
          </div>
          {book.data.rating && book.data.status !== 'want' && (
            <div class="book-field">
              <span class="book-field-label">rating</span>
              <span class="book-field-value book-rating">
                {'★'.repeat(book.data.rating)}{'☆'.repeat(5 - book.data.rating)}
              </span>
            </div>
          )}
          {book.data.tags.length > 0 && (
            <div class="book-field book-field--tags">
              <span class="book-field-label">tags</span>
              <div class="book-detail-tags">
                {book.data.tags.map(tag => (
                  <span class="book-tag">{tag}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Notes / review -->
    {book.data.status !== 'want' || true ? (
      <div class="book-notes-section">
        <div class="section-label">
          {book.data.status === 'want' ? 'Why I Want to Read This' : 'Notes'}
        </div>
        <div class="prose book-prose">
          <Content />
        </div>
      </div>
    ) : null}

    <!-- Related writing -->
    {relatedPosts.length > 0 && (
      <div class="book-related-section">
        <div class="section-label">Related Writing</div>
        <ul class="posts-list">
          {relatedPosts.map(post => (
            <li class="post-item">
              <a href={post.href} class="post-link">
                <span class={`post-title${post.lang === 'ar' ? ' post-title-ar' : ''}`}>
                  {post.title}
                </span>
                <span class="post-meta">
                  <span class="post-lang">{post.lang}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

  </div>
</Base>

