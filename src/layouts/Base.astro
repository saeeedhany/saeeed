---
import '../styles/global.css';

interface Props {
title?: string;
description?: string;
}

const {
title = 'Saeed - The one who knocks',
description = 'Systems, CLI tools, low-level stuff. Writing about operating systems, architecture, C, and the web.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <script is:inline>
        (function() {
            var t = localStorage.getItem('theme');
            if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
        })();
        </script>
    </head>
    <body>
        <nav id="main-nav">
            <div class="container">
                <div class="nav-inner">
                    <a href="/" class="nav-logo">Saeed</a>

                    <ul class="nav-links">
                        <li><a href="/" class={currentPath === '/' ? 'active' : ''}>home</a></li>
                        <li><a href="/posts" class={currentPath.startsWith('/posts') ? 'active' : ''}>writing</a></li>
                        <li><a href="/books" class={currentPath.startsWith('/books') ? 'active' : ''}>books</a></li>
                        <li>
                            <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
                                <span id="theme-icon">light</span>
                            </button>
                        </li>
                    </ul>

                    <button class="nav-hamburger" id="hamburger" aria-label="Menu">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </div>
        </nav>

        <div class="nav-mobile" id="nav-mobile">
            <button class="nav-mobile-close" id="nav-mobile-close" aria-label="Close menu">
                <span></span><span></span>
            </button>
            <a href="/" class={currentPath === '/' ? 'active' : ''}>home</a>
            <a href="/posts" class={currentPath.startsWith('/posts') ? 'active' : ''}>writing</a>
            <a href="/books" class={currentPath.startsWith('/books') ? 'active' : ''}>books</a>
            <button class="theme-toggle" id="theme-toggle-mobile">
                <span id="theme-label-mobile">light mode</span>
            </button>
        </div>

        <slot />

        <div class="container">
            <footer>
                <div class="footer-inner">
                    <span>© {new Date().getFullYear()} Saeed</span>
                    <div class="footer-links">
                        <a href="https://github.com/saeeedhany" target="_blank" rel="noopener">GitHub</a>
                        <a href="https://x.com/S8eed_" target="_blank" rel="noopener">X</a>
                        <a href="https://www.reddit.com/user/s_saeed_1/" target="_blank" rel="noopener">Reddit</a>
                        <a href="mailto:alsaeedalbasi0ny@gmail.com">say hi</a>
                    </div>
                </div>
            </footer>
        </div>
    </body>
</html>

<script>
import { initTheme }   from '../scripts/theme';
import { initNav }     from '../scripts/nav';
import { buildTOC }    from '../scripts/toc';
import { initPostsFilter } from '../scripts/posts-filter';
import { initBooksFilter } from '../scripts/books-filter';

initTheme();
initNav();
buildTOC();
initPostsFilter();
initBooksFilter();
</script>
