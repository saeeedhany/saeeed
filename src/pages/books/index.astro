---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allBooks = await getCollection('books', ({ data }) => !data.draft);

const byStatus = {
  reading: allBooks.filter(b => b.data.status === 'reading'),
  read:    allBooks.filter(b => b.data.status === 'read'),
  want:    allBooks.filter(b => b.data.status === 'want'),
};

const statusLabel: Record<string, string> = {
  reading: 'Currently Reading',
  read:    'Read',
  want:    'Want to Read',
};

const statusColor: Record<string, string> = {
  reading: 'var(--amber)',
  read:    'var(--phosphor)',
  want:    'var(--muted)',
};

const allTags = [...new Set(allBooks.flatMap(b => b.data.tags))].sort();
---

<Base title="Books — Saeed">
  <div class="container">
    <div class="section-label" style="margin-bottom: 32px;">Books</div>

    <p class="books-intro">
      Things I've read, am reading, or intend to read. With notes.
    </p>

    <!-- Tag filter -->
    <div class="tag-filter" id="books-tag-filter">
      <button class="tag-btn active" data-tag="all">All</button>
      {allTags.map(tag => (
        <button class="tag-btn" data-tag={tag}>{tag}</button>
      ))}
    </div>

    <!-- Sections by status -->
    {(['reading', 'read', 'want'] as const).filter(s => byStatus[s].length > 0).map(status => (
      <section class="books-section" data-status={status}>
        <div class="books-section-label" style={`color: ${statusColor[status]}`}>
          {statusLabel[status]}
          <span class="books-count">{byStatus[status].length}</span>
        </div>
        <div class="books-grid" id={`books-grid-${status}`}>
          {byStatus[status].map(book => (
            <a href={`/books/${book.slug}`} class="book-card" data-tags={book.data.tags.join(',')}>
              <div class="book-card-cover">
                {book.data.cover ? (
                  <img src={book.data.cover} alt={book.data.title} />
                ) : (
                  <div class="book-card-cover-placeholder">
                    <span>{book.data.title.slice(0, 2).toUpperCase()}</span>
                  </div>
                )}
              </div>
              <div class="book-card-body">
                <div class="book-card-title">{book.data.title}</div>
                <div class="book-card-author">{book.data.author}</div>
                {book.data.year && (
                  <div class="book-card-year">{book.data.year}</div>
                )}
                {book.data.rating && status !== 'want' && (
                  <div class="book-card-rating">
                    {'★'.repeat(book.data.rating)}{'☆'.repeat(5 - book.data.rating)}
                  </div>
                )}
                <div class="book-card-tags">
                  {book.data.tags.map(tag => (
                    <span class="book-tag">{tag}</span>
                  ))}
                </div>
              </div>
              <div class="book-card-arrow">→</div>
            </a>
          ))}
        </div>
      </section>
    ))}

  </div>
</Base>

<style>
.books-intro {
  font-size: 0.85rem;
  color: var(--muted);
  margin-bottom: 32px;
  line-height: 1.7;
}

.tag-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 48px;
}

.tag-btn {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 3px 10px;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--muted);
  cursor: pointer;
  transition: all var(--transition);
}

.tag-btn:hover {
  border-color: var(--cream);
  color: var(--cream);
}

.tag-btn.active {
  border-color: var(--blue);
  color: var(--blue);
  background: rgba(58, 143, 196, 0.06);
}

.books-section {
  margin-bottom: 56px;
}

.books-section-label {
  font-size: 0.65rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.books-section-label::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}

.books-count {
  font-size: 0.58rem;
  color: var(--muted);
  letter-spacing: 0.04em;
}

.books-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.book-card {
  display: grid;
  grid-template-columns: 48px 1fr auto;
  align-items: center;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
  color: inherit;
  text-decoration: none;
  transition: background var(--transition);
  position: relative;
}

.book-card:first-child {
  border-top: 1px solid var(--border);
}

.book-card:hover {
  background: rgba(255,255,255,0.02);
  padding-left: 6px;
  padding-right: 6px;
  margin: 0 -6px;
}

[data-theme="light"] .book-card:hover {
  background: rgba(0,0,0,0.02);
}

.book-card-cover {
  width: 48px;
  height: 64px;
  flex-shrink: 0;
  overflow: hidden;
  border: 1px solid var(--border);
}

.book-card-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.book-card-cover-placeholder {
  width: 100%;
  height: 100%;
  background: var(--bg-3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-card-cover-placeholder span {
  font-size: 0.65rem;
  color: var(--muted);
  letter-spacing: 0.06em;
  font-weight: 500;
}

.book-card-body {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.book-card-title {
  font-size: 0.875rem;
  color: var(--cream);
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: color var(--transition);
}

.book-card:hover .book-card-title {
  color: var(--blue);
}

.book-card-author {
  font-size: 0.7rem;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-card-year {
  font-size: 0.65rem;
  color: var(--muted);
  opacity: 0.6;
}

.book-card-rating {
  font-size: 0.62rem;
  color: var(--amber);
  letter-spacing: 1px;
}

.book-card-tags {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  margin-top: 2px;
}

.book-tag {
  font-size: 0.58rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--phosphor);
  background: rgba(74, 158, 92, 0.08);
  padding: 1px 5px;
}

.book-card-arrow {
  font-size: 0.65rem;
  color: var(--border);
  transition: color var(--transition), transform var(--transition);
  flex-shrink: 0;
}

.book-card:hover .book-card-arrow {
  color: var(--blue);
  transform: translateX(3px);
}

/* Hidden state for filtering */
.book-card.hidden {
  display: none;
}

@media (max-width: 480px) {
  .book-card {
    grid-template-columns: 40px 1fr auto;
    gap: 12px;
  }
  .book-card-cover {
    width: 40px;
    height: 54px;
  }
}
</style>

<script>
function initBooksPage() {
  if (!document.getElementById('books-tag-filter')) return;

  const tagBtns = document.querySelectorAll<HTMLButtonElement>('#books-tag-filter .tag-btn');
  const bookCards = document.querySelectorAll<HTMLElement>('.book-card');

  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tagBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tag = btn.dataset.tag || 'all';

      bookCards.forEach(card => {
        const cardTags = (card.dataset.tags || '').split(',');
        const show = tag === 'all' || cardTags.includes(tag);
        card.classList.toggle('hidden', !show);
      });

      document.querySelectorAll<HTMLElement>('.books-section').forEach(section => {
        const visible = section.querySelectorAll('.book-card:not(.hidden)').length;
        section.style.display = visible === 0 ? 'none' : '';
      });
    });
  });
}

initBooksPage();
document.addEventListener('astro:page-load', initBooksPage);
</script>
