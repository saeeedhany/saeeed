---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const enPosts = await getCollection('en', ({ data }) => !data.draft);
const arPosts = await getCollection('ar', ({ data }) => !data.draft);

const enSorted = enPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const arSorted = arPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const enTags = [...new Set(enPosts.flatMap(p => p.data.tags))].sort();
const arTags = [...new Set(arPosts.flatMap(p => p.data.tags))].sort();

function fmtEn(date: Date) {
return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
function fmtAr(date: Date) {
return date.toLocaleDateString('ar-EG', { year: 'numeric', month: 'short' });
}
---

<Base title="Writing - saeed">
    <div class="container">

        <div class="page-verse" dir="rtl">
            <div class="verse-col">
                <p>سَيَشْهَدُ الحَرْفُ أنَّ الحِبرَ أَدمُعنا</p>
                <p>لَو يَعلَمُونَ أنَّ السَّطرَ أَوجَاعُ</p>
            </div>
            <div class="verse-col">
                <p>وَيَقْرَأُ النَّاسُ أَحْرُفَنا فَتُعْجِبُهُم</p>
                <p>وَيَحسَبُونَ أن الحُزنَ إبْدَاعُ</p>
            </div>
        </div>

        <div class="section-label" style="margin-bottom: 32px;">Writing</div>

        <!-- ── Lang switcher ── -->
        <div class="lang-switcher">
            <button class="lang-btn active" data-lang="en">English</button>
            <button class="lang-btn" data-lang="ar">العربية</button>
        </div>

        <!-- ── ENGLISH SECTION ── -->
        <section id="section-en" class="lang-section">
            <div class="tag-filter" id="en-tag-filter">
                <button class="tag-btn active" data-tag="all">All</button>
                {enTags.map(tag => (
                <button class="tag-btn" data-tag={tag}>{tag}</button>
                ))}
            </div>
            <ul class="posts-list" id="en-posts">
                {enSorted.map(post => (
                <li class="post-item" data-tags={post.data.tags.join(',')}>
                    <a href={`/posts/en/${post.slug}`} class="post-link">
                        <span class="post-title">{post.data.title}</span>
                        <span class="post-meta">
                            {post.data.tags.slice(0, 2).map(tag => (
                            <span class="post-tag">{tag}</span>
                            ))}
                            <span class="post-date">{fmtEn(post.data.date)}</span>
                        </span>
                    </a>
                </li>
                ))}
            </ul>
            <div id="en-empty" class="empty-state" style="display:none;"><p>No posts found.</p></div>
        </section>

        <!-- ── ARABIC SECTION ── -->
        <section id="section-ar" class="lang-section" style="display:none;" dir="rtl">
            <div class="tag-filter" id="ar-tag-filter">
                <button class="tag-btn-ar active-ar" data-tag="all">الكل</button>
                {arTags.map(tag => (
                <button class="tag-btn-ar" data-tag={tag}>{tag}</button>
                ))}
            </div>
            <ul class="posts-list" id="ar-posts">
                {arSorted.map(post => (
                <li class="post-item" data-tags={post.data.tags.join(',')}>
                    <a href={`/posts/ar/${post.slug}`} class="post-link">
                        <span class="post-title post-title-ar">{post.data.title}</span>
                        <span class="post-meta" style="flex-direction:row-reverse;">
                            {post.data.tags.slice(0, 2).map(tag => (
                            <span class="post-tag">{tag}</span>
                            ))}
                            <span class="post-date">{fmtAr(post.data.date)}</span>
                        </span>
                    </a>
                </li>
                ))}
            </ul>
            <div id="ar-empty" class="empty-state" style="display:none;"><p>لا توجد مقالات.</p></div>
        </section>

    </div>
</Base>

<style>
.lang-switcher {
  display: flex;
  gap: 0;
  margin-bottom: 28px;
  border-bottom: 1px solid var(--border);
}

.lang-btn {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  padding: 8px 20px 10px;
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  color: var(--muted);
  cursor: pointer;
  transition: all var(--transition);
  margin-bottom: -1px;
}

.lang-btn:hover { color: var(--cream); }

.lang-btn.active {
  color: var(--cream);
  border-bottom-color: var(--blue);
}

.lang-btn[data-lang="ar"] {
  font-family: var(--font-ar);
  font-size: 0.85rem;
}

.lang-btn[data-lang="ar"].active {
  border-bottom-color: var(--amber);
}

.tag-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 28px;
}

.tag-btn {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 3px 10px;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--muted);
  cursor: pointer;
  transition: all var(--transition);
}

.tag-btn:hover {
  border-color: var(--cream);
  color: var(--cream);
}

.tag-btn.active {
  border-color: var(--blue);
  color: var(--blue);
  background: rgba(58, 143, 196, 0.06);
}

/* Arabic tag buttons */
.tag-btn-ar {
  font-family: var(--font-ar);
  font-size: 0.75rem;
  padding: 3px 10px;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--muted);
  cursor: pointer;
  transition: all var(--transition);
}

.tag-btn-ar:hover {
  border-color: var(--cream);
  color: var(--cream);
}

.tag-btn-ar.active-ar {
  border-color: var(--amber);
  color: var(--amber);
  background: rgba(200, 169, 74, 0.06);
}

.empty-state p {
  color: var(--muted);
  font-size: 0.8rem;
  padding: 40px 0;
}
</style>


